rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {
    match /{document=**} {
      allow read, write: if false;
    }

    function isValidId(id) {
      return id is string && id.size() >= 1 && id.size() <= 128 && id.matches('^[a-zA-Z0-9_\\-]+$');
    }

    function incoming() {
      return request.resource.data;
    }

    function existing() {
      return resource.data;
    }

    function isSignedIn() {
      return request.auth != null;
    }

    function isVerified() {
      return isSignedIn() && request.auth.token.email_verified == true;
    }

    function isValidWeaponUpgrade(lvl) {
      return lvl is map
        && lvl.keys().hasAll(['damageLevel', 'radiusLevel', 'shellsLevel'])
        && lvl.keys().hasOnly(['damageLevel', 'radiusLevel', 'shellsLevel'])
        && lvl.damageLevel is int && lvl.damageLevel >= 0 && lvl.damageLevel <= 3
        && lvl.radiusLevel is int && lvl.radiusLevel >= 0 && lvl.radiusLevel <= 3
        && lvl.shellsLevel is int && lvl.shellsLevel >= 0 && lvl.shellsLevel <= 2;
    }

    function isValidWeaponUpgradesMap(upgrades) {
      return upgrades is map
        && upgrades.keys().hasAll(['standard', 'cluster', 'mortar'])
        && upgrades.keys().hasOnly(['standard', 'cluster', 'mortar'])
        && isValidWeaponUpgrade(upgrades.standard)
        && isValidWeaponUpgrade(upgrades.cluster)
        && isValidWeaponUpgrade(upgrades.mortar);
    }

    function isValidPlayerSave(data) {
      return data.keys().hasAll([
        'userId', 'displayName', 'totalXp', 'credits', 'unlockedStage', 'tutorialCompleted',
        'bestScore', 'bestStreak', 'totalSolved', 'totalAttempted', 'gamesPlayed',
        'preferredSpec', 'soundEnabled', 'tankColor', 'unlockedWeapons', 'weaponUpgrades',
        'lastSyncedDevice', 'createdAt', 'updatedAt'
      ])
      && data.keys().hasOnly([
        'userId', 'displayName', 'totalXp', 'credits', 'unlockedStage', 'tutorialCompleted',
        'bestScore', 'bestStreak', 'totalSolved', 'totalAttempted', 'gamesPlayed',
        'preferredSpec', 'soundEnabled', 'tankColor', 'unlockedWeapons', 'weaponUpgrades',
        'lastSyncedDevice', 'createdAt', 'updatedAt'
      ])
      && isValidId(data.userId)
      && data.displayName is string && data.displayName.size() >= 1 && data.displayName.size() <= 40
      && data.totalXp is int && data.totalXp >= 0 && data.totalXp <= 10000000
      && data.credits is int && data.credits >= 0 && data.credits <= 10000000
      && data.unlockedStage is int && data.unlockedStage >= 1 && data.unlockedStage <= 20
      && data.tutorialCompleted is bool
      && data.bestScore is int && data.bestScore >= 0 && data.bestScore <= 1000000
      && data.bestStreak is int && data.bestStreak >= 0 && data.bestStreak <= 1000
      && data.totalSolved is int && data.totalSolved >= 0 && data.totalSolved <= 1000000
      && data.totalAttempted is int && data.totalAttempted >= 0 && data.totalAttempted <= 1000000
      && data.gamesPlayed is int && data.gamesPlayed >= 0 && data.gamesPlayed <= 100000
      && data.preferredSpec in ['eco', 'balanced', 'high']
      && data.soundEnabled is bool
      && data.tankColor is string && data.tankColor.size() == 7 && data.tankColor.matches('^#[0-9a-fA-F]{6}$')
      && data.unlockedWeapons is list && data.unlockedWeapons.size() >= 1 && data.unlockedWeapons.size() <= 3
      && data.unlockedWeapons.hasOnly(['standard', 'cluster', 'mortar'])
      && isValidWeaponUpgradesMap(data.weaponUpgrades)
      && data.lastSyncedDevice is string && data.lastSyncedDevice.size() >= 1 && data.lastSyncedDevice.size() <= 48
      && data.createdAt is timestamp
      && data.updatedAt is timestamp;
    }

    function isValidLeaderboardEntry(data) {
      return data.keys().hasAll([
        'userId', 'displayName', 'bestScore', 'highestTier', 'accuracyPct',
        'bestStreak', 'totalSolved', 'gamesPlayed', 'isPublic', 'createdAt', 'updatedAt'
      ])
      && data.keys().hasOnly([
        'userId', 'displayName', 'bestScore', 'highestTier', 'accuracyPct',
        'bestStreak', 'totalSolved', 'gamesPlayed', 'isPublic', 'createdAt', 'updatedAt'
      ])
      && isValidId(data.userId)
      && data.displayName is string && data.displayName.size() >= 1 && data.displayName.size() <= 40
      && data.bestScore is int && data.bestScore >= 0 && data.bestScore <= 1000000
      && data.highestTier is int && data.highestTier >= 1 && data.highestTier <= 5
      && data.accuracyPct is int && data.accuracyPct >= 0 && data.accuracyPct <= 100
      && data.bestStreak is int && data.bestStreak >= 0 && data.bestStreak <= 1000
      && data.totalSolved is int && data.totalSolved >= 0 && data.totalSolved <= 1000000
      && data.gamesPlayed is int && data.gamesPlayed >= 0 && data.gamesPlayed <= 100000
      && data.isPublic == true
      && data.createdAt is timestamp
      && data.updatedAt is timestamp;
    }

    match /saves/{userId} {
      allow get: if isSignedIn() && isValidId(userId) && request.auth.uid == userId;
      allow list: if false;
      allow create: if isVerified()
        && isValidId(userId)
        && request.auth.uid == userId
        && isValidPlayerSave(incoming())
        && incoming().userId == request.auth.uid
        && incoming().createdAt == request.time
        && incoming().updatedAt == request.time;
      allow update: if isVerified()
        && isValidId(userId)
        && request.auth.uid == userId
        && isValidPlayerSave(incoming())
        && incoming().userId == existing().userId
        && incoming().createdAt == existing().createdAt
        && incoming().updatedAt == request.time
        && incoming().diff(existing()).affectedKeys().hasOnly([
          'displayName', 'totalXp', 'credits', 'unlockedStage', 'tutorialCompleted',
          'bestScore', 'bestStreak', 'totalSolved', 'totalAttempted', 'gamesPlayed',
          'preferredSpec', 'soundEnabled', 'tankColor', 'unlockedWeapons', 'weaponUpgrades',
          'lastSyncedDevice', 'updatedAt'
        ]);
      allow delete: if isSignedIn() && isValidId(userId) && request.auth.uid == userId;
    }

    match /leaderboard/{userId} {
      allow get: if isValidId(userId) && resource.data.isPublic == true;
      allow list: if resource.data.isPublic == true;
      allow create: if isVerified()
        && isValidId(userId)
        && request.auth.uid == userId
        && isValidLeaderboardEntry(incoming())
        && incoming().userId == request.auth.uid
        && incoming().createdAt == request.time
        && incoming().updatedAt == request.time;
      allow update: if isVerified()
        && isValidId(userId)
        && request.auth.uid == userId
        && isValidLeaderboardEntry(incoming())
        && incoming().userId == existing().userId
        && incoming().createdAt == existing().createdAt
        && incoming().updatedAt == request.time
        && incoming().diff(existing()).affectedKeys().hasOnly([
          'displayName', 'bestScore', 'highestTier', 'accuracyPct',
          'bestStreak', 'totalSolved', 'gamesPlayed', 'isPublic', 'updatedAt'
        ]);
      allow delete: if isSignedIn() && isValidId(userId) && request.auth.uid == userId;
    }
  }
}
